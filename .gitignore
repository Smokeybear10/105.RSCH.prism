# Local data / caches (HF pulls, parquet caches, etc. — never commit raw bulk data).
# Ignore everything under top-level data/ EXCEPT the legacy focal_chunks.jsonl
# research fixture. (gitignore can't re-include files
# whose parent directory is excluded, so we must use data/* not data/.)
data/*
!data/thirteen_f/
data/thirteen_f/*
!data/thirteen_f/focal_chunks.jsonl

# Preserve the legacy per-ticker research fixtures; the demo UI was removed.
!demo/static/data/
!demo/static/data/*.json
# Generated backtest outputs
out/
.gstack/
